      "eInput": 20.0,
      "eOutput": 15.0,
      "peakGridImportKwh": 13.8,
      "offpeak": {
        "gridImportKwh": 6.0,
        "windowStart": "11:00",
        "windowEnd": "14:00",
        "integratedAt": "2026-04-12T04:00:00Z",
        "sampleCount": 900
      },
      "bandImports": null
    },
    "expected": { "tier": 2, "importCost": 4.83, "feedInIncome": 0.75, "net": 4.08, "savings": 2.1 }
  },
